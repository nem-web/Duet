<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/img_todo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_todo" />

        <TextView
            android:id="@+id/tv_todo_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/img_todo"
            android:layout_centerVertical="true"
            android:layout_marginStart="6dp"
            android:text="Couple To-Dos"
            android:textColor="#FBBF24"
            android:textSize="13sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Scrollable ListView of Todos -->
    <ListView
        android:id="@+id/lv_todos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="4dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_empty_todos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="No active to-dos! 🎉"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
